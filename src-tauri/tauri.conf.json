{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBJETUNE",
  "version": "0.1.0",
  "identifier": "com.objetune.app",
  "build": {
    "frontendDist": "../frontend/build",
    "beforeDevCommand": "cd frontend && npm start",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OBJETUNE",
        "url": "http://localhost:3000",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/1024x1024.png"
    ]
  }
}
