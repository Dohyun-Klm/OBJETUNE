{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBJETUNE",
  "version": "0.1.0",
  "identifier": "com.objetune.app",
  "build": {
    "frontendDist": "../frontend/build",
    "beforeDevCommand": "cd frontend && npm start",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OBJETUNE",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "maxWidth": 2560,
        "maxHeight": 1440,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "focusable": true,
        "decorations": true,
        "transparent": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": "all",
    "resources": [
      "../server/target/release/objetune-api*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/1024x1024.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
